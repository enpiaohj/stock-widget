<views:GlassWindow x:Class="StockWidget.App.Views.MainWindow"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:views="clr-namespace:StockWidget.App.Views"
                   Title="股票小插件"
                   Width="420" SizeToContent="Height"
                   WindowStartupLocation="Manual"
                   ShowActivated="True"
                   Background="{DynamicResource BgBrush}"
                   TextOptions.TextRenderingMode="ClearType"
                   UseLayoutRounding="True">

    <Border x:Name="CardShadowHost" CornerRadius="0" Margin="0" Background="Transparent">
        <Border CornerRadius="0" ClipToBounds="True">
            <Border Background="{DynamicResource CardGradientBrush}"
                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                    CornerRadius="0">
                <Border CornerRadius="0" Background="{DynamicResource HoverStrokeBrush}"
                        BorderThickness="1" BorderBrush="{DynamicResource HoverStrokeBrush}"
                        Opacity="0.6" Margin="1">
                    <Grid Margin="8,6,8,6" Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 行情表 -->
            <DataGrid x:Name="Grid" Grid.Row="1"
                      ItemsSource="{Binding Rows}"
                      SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                      Background="Transparent"
                      Foreground="{DynamicResource FgBrush}"
                      FontFamily="{Binding RowFontFamily, RelativeSource={RelativeSource AncestorType=Window}}"
                      FontSize="{Binding RowFontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                      FontStyle="{Binding RowFontStyle, RelativeSource={RelativeSource AncestorType=Window}}"
                      VirtualizingPanel.ScrollUnit="Pixel"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <DataGrid.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.ContainerStyle>
                            <Style TargetType="GroupItem" BasedOn="{StaticResource CategoryGroupHeaderStyle}" />
                        </GroupStyle.ContainerStyle>
                    </GroupStyle>
                </DataGrid.GroupStyle>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                        <Setter Property="Background" Value="{Binding FlashBrush}" />
                        <EventSetter Event="MouseEnter" Handler="Row_MouseEnter" />
                        <EventSetter Event="MouseDoubleClick" Handler="Row_MouseDoubleClick" />
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>

            <!-- 底部量能栏 -->
            <Grid Grid.Row="2" Margin="2,4,2,2" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="AmountText" Grid.Column="0" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           FontFamily="{Binding RowFontFamily, RelativeSource={RelativeSource AncestorType=Window}}"
                           FontStyle="{Binding RowFontStyle, RelativeSource={RelativeSource AncestorType=Window}}"
                           MouseLeave="AmountText_MouseLeave"
                           MouseMove="AmountText_MouseMove" />
                <Border x:Name="LockBadge" Grid.Column="1" Visibility="Collapsed"
                        Background="{DynamicResource AccentSoftBrush}" CornerRadius="5"
                        Padding="8,2" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="窗口位置已锁定">
                    <TextBlock Text="🔒 已锁定" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource LockBrush}" />
                </Border>
                <Border x:Name="MarketClosedBadge" Grid.Column="1" Visibility="Collapsed"
                        Background="{DynamicResource AccentSoftBrush}" CornerRadius="5"
                        Padding="8,2" VerticalAlignment="Center" Margin="8,0,0,0">
                    <TextBlock Text="休市" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}" />
                </Border>
            </Grid>
        </Grid>
                </Border>
            </Border>
        </Border>
    </Border>
</views:GlassWindow>
