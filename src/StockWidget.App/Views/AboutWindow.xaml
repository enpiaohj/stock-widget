<views:GlassWindow x:Class="StockWidget.App.Views.AboutWindow"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:views="clr-namespace:StockWidget.App.Views"
                   Title="关于"
                   Width="380" SizeToContent="Height"
                   WindowStartupLocation="CenterOwner"
                   ResizeMode="NoResize"
                   ShowInTaskbar="False"
                   Background="{DynamicResource BgBrush}"
                   MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <StackPanel Margin="24,20">
        <TextBlock x:Name="TitleText" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource FgBrush}"
                   HorizontalAlignment="Center" />
        <TextBlock x:Name="DeveloperText" Margin="0,10,0,0" Foreground="{DynamicResource SubFgBrush}"
                   HorizontalAlignment="Center" />
        <TextBlock x:Name="HotkeyText" Margin="0,4,0,0" Foreground="{DynamicResource SubFgBrush}"
                   HorizontalAlignment="Center" />
        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,14" />
        <TextBlock Foreground="{DynamicResource FgBrush}" TextWrapping="Wrap" LineHeight="22" FontSize="12"
                   HorizontalAlignment="Center" TextAlignment="Center">
            显示股票实时行情与沪深两市量能变化<LineBreak />
            右键菜单：添加股票 / 设置字段 / 刷新频率 / 字体 / 透明度<LineBreak />
            双击行情行查看当日分时 · 表头单击排序 · 双击表头隐藏窗口
        </TextBlock>
        <TextBlock Margin="0,14,0,0" Foreground="{DynamicResource SubFgBrush}" FontSize="11"
                   HorizontalAlignment="Center">
            C# / WPF (.NET 10) 重写版 · 本地 SQLite 存储
        </TextBlock>
        <TextBlock Margin="0,10,0,0" Foreground="{DynamicResource SubFgBrush}" FontSize="11"
                   HorizontalAlignment="Center" Text="感谢使用和支持！" />
        <Button Content="关闭" Width="110" Margin="0,18,0,0" Style="{StaticResource PrimaryButtonStyle}"
                HorizontalAlignment="Center" Click="Close_Click" />
    </StackPanel>
</views:GlassWindow>
