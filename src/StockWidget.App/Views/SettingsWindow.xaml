<views:GlassWindow x:Class="StockWidget.App.Views.SettingsWindow"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:views="clr-namespace:StockWidget.App.Views"
                   Title="设置中心"
                   Width="560" Height="520"
                   WindowStartupLocation="CenterOwner"
                   ResizeMode="NoResize"
                   ShowInTaskbar="False"
                   Background="{DynamicResource BgBrush}">
    <!-- 与主窗口对齐的渐变卡片容器（深色主题层次一致） -->
    <Border CornerRadius="0" Background="{DynamicResource CardGradientBrush}"
            BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" Margin="0">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl x:Name="Tabs" Grid.Row="0" Background="Transparent">

            <!-- Tab 1：显示设置 -->
            <TabItem Header="显示设置">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="界面外观" Style="{StaticResource CardHeaderText}" />
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="主题" VerticalAlignment="Center" Foreground="{DynamicResource FgBrush}" />
                                    <ComboBox x:Name="ThemeBox" Grid.Column="1" Width="200" HorizontalAlignment="Left"
                                              SelectionChanged="ThemeBox_SelectionChanged">
                                        <ComboBoxItem Content="深色" Tag="dark" />
                                        <ComboBoxItem Content="浅色" Tag="light" />
                                        <ComboBoxItem Content="跟随系统" Tag="system" />
                                    </ComboBox>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="窗口透明度" VerticalAlignment="Center" Foreground="{DynamicResource FgBrush}" />
                                    <Slider x:Name="OpacitySlider" Grid.Column="1" Minimum="10" Maximum="100"
                                            ValueChanged="Opacity_ValueChanged" VerticalAlignment="Center" />
                                    <views:SpinnerBox x:Name="OpacityBox" Grid.Column="2" Width="96" HorizontalAlignment="Left"
                                              Margin="10,0,0,0" Min="10" Max="100" Step="10" ValueChanged="OpacityBox_ValueChanged" />
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="118" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="字体" VerticalAlignment="Center" Foreground="{DynamicResource FgBrush}" />
                                    <ComboBox x:Name="FontBox" Grid.Column="1" MaxDropDownHeight="240" />
                                    <views:SpinnerBox x:Name="FontSizeBox" Grid.Column="2" Width="104" Margin="8,0,0,0"
                                             Min="6" Max="28" />
                                    <CheckBox x:Name="ItalicCheck" Grid.Column="3" Content="斜体"
                                              Margin="12,0,0,0" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="数据刷新" Style="{StaticResource CardHeaderText}" />
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="刷新间隔（秒）" VerticalAlignment="Center" Foreground="{DynamicResource FgBrush}" />
                                    <views:SpinnerBox x:Name="IntervalBox" Grid.Column="1" Width="106" HorizontalAlignment="Left"
                                             Min="1" Max="120" />
                                    <TextBlock Grid.Column="2" Text="1 – 120 秒" VerticalAlignment="Center"
                                               Margin="8,0,0,0" Foreground="{DynamicResource SubFgBrush}" FontSize="11" />
                                </Grid>
                                <CheckBox x:Name="ShowAmountCheck" Content="显示沪深两市成交额" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="窗口与状态栏" Style="{StaticResource CardHeaderText}" />
                                <CheckBox x:Name="ShowDividersCheck" Content="显示行间分隔线" Margin="0,2" />
                                <CheckBox x:Name="ShowIntervalCheck" Content="显示刷新间隔" Margin="0,2" />
                                <CheckBox x:Name="ShowLockCheck" Content="显示锁定状态" Margin="0,2" />
                                <CheckBox x:Name="ShowWeekdayCheck" Content="显示星期" Margin="0,2" />
                                <CheckBox x:Name="ShowWeekNumberCheck" Content="显示周数（第几周）" Margin="0,2" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 2：显示字段 -->
            <TabItem Header="显示字段">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="必选字段" Style="{StaticResource CardHeaderText}" />
                                <WrapPanel x:Name="RequiredPanel" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="可选字段（勾选显示，可设列宽）" Style="{StaticResource CardHeaderText}" />
                                <WrapPanel x:Name="OptionalPanel" />
                            </StackPanel>
                        </Border>
                        <Button Content="恢复默认显示字段" Width="140" HorizontalAlignment="Left"
                                Click="ResetFields_Click" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 3：快捷键 -->
            <TabItem Header="快捷键">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="显示 / 隐藏窗口全局热键" Style="{StaticResource CardHeaderText}" />
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="HotkeyBox" Margin="0,0,8,0" />
                                    <Button x:Name="CaptureButton" Grid.Column="1" Content="🎧 开始监听"
                                            Width="110" Click="Capture_Click" />
                                </Grid>
                                <TextBlock Text="格式：ctrl / alt / shift / win + 主键，如 ctrl+q、alt+z。监听时按下组合键自动填入。"
                                           Foreground="{DynamicResource SubFgBrush}" FontSize="11"
                                           TextWrapping="Wrap" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 4：预警 -->
            <TabItem Header="预警">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="涨跌幅预警" Style="{StaticResource CardHeaderText}" />
                                <CheckBox x:Name="AlertsEnabledCheck" Content="启用涨跌幅预警（触发时弹系统通知）" Margin="0,2" />
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="AlertCodeBox" Style="{StaticResource NumericBoxStyle}"
                                             HorizontalAlignment="Stretch" Margin="0,0,6,0" />
                                    <TextBox x:Name="AlertThresholdBox" Grid.Column="1" Margin="0,0,6,0"
                                             Style="{StaticResource NumericBoxStyle}" />
                                    <ComboBox x:Name="AlertDirectionBox" Grid.Column="2" Margin="0,0,6,0" SelectedIndex="0">
                                        <ComboBoxItem Content="涨跌均可" />
                                        <ComboBoxItem Content="仅上涨" />
                                        <ComboBoxItem Content="仅下跌" />
                                    </ComboBox>
                                    <Button Grid.Column="3" Content="添加" Width="64" Click="AddAlert_Click" />
                                </Grid>
                                <TextBlock Text="代码示例：sh600390；阈值为涨跌幅百分比，如 5 表示 ±5%。同一交易日同一规则只提醒一次。"
                                           Foreground="{DynamicResource SubFgBrush}" FontSize="11"
                                           TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="已有规则" Style="{StaticResource CardHeaderText}" />
                                <ItemsControl x:Name="AlertList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="70" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource FgBrush}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding DirectionText}"
                                                           Foreground="{DynamicResource SubFgBrush}" FontSize="11"
                                                           VerticalAlignment="Center" />
                                                <CheckBox Grid.Column="2" IsChecked="{Binding Enabled}"
                                                          Checked="AlertEnabled_Changed" Unchecked="AlertEnabled_Changed"
                                                          VerticalAlignment="Center" Margin="10,0" />
                                                <Button Grid.Column="3" Content="删除" Click="DeleteAlert_Click" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 5：AI 分析 -->
            <TabItem x:Name="AiTabItem" Header="AI 分析">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="DeepSeek API" Style="{StaticResource CardHeaderText}" />
                                <CheckBox x:Name="AiEnabledCheck" Content="启用 AI 分析（DeepSeek）" Margin="0,2" />
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="API Base URL" VerticalAlignment="Center" Foreground="{DynamicResource FgBrush}" />
                                    <TextBox x:Name="AiBaseUrlBox" Grid.Column="1" Margin="0,2" />
                                    <TextBlock Grid.Row="1" Text="API Key" VerticalAlignment="Center" Foreground="{DynamicResource FgBrush}" />
                                    <Grid Grid.Row="1" Grid.Column="1" Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid>
                                            <PasswordBox x:Name="AiKeyBox" Background="{DynamicResource ControlBgBrush}"
                                                         Foreground="{DynamicResource FgBrush}"
                                                         BorderBrush="{DynamicResource ControlBorderBrush}"
                                                         Padding="4,3" PasswordChanged="AiKeyBox_PasswordChanged" />
                                            <TextBox x:Name="AiKeyTextBox" Visibility="Collapsed"
                                                     Background="{DynamicResource ControlBgBrush}"
                                                     Foreground="{DynamicResource FgBrush}"
                                                     BorderBrush="{DynamicResource ControlBorderBrush}"
                                                     Padding="4,3" TextChanged="AiKeyTextBox_TextChanged" />
                                        </Grid>
                                        <Button x:Name="AiKeyEyeButton" Content="👁" Width="56" Grid.Column="1" Margin="6,0,0,0"
                                                Click="AiKeyEye_Click" ToolTip="显示 / 隐藏 API Key（检查空格）" />
                                        <Button Content="清空" Width="56" Grid.Column="2" Margin="6,0,0,0" Click="AiKeyClear_Click"
                                                ToolTip="清除已保存的 API Key" />
                                    </Grid>
                                    <TextBlock Grid.Row="2" Text="Model" VerticalAlignment="Center" Foreground="{DynamicResource FgBrush}" />
                                    <ComboBox x:Name="AiModelBox" Grid.Row="2" Grid.Column="1" IsEditable="True" Margin="0,2" />
                                    <TextBlock Grid.Row="3" Text="Timeout（秒）" VerticalAlignment="Center" Foreground="{DynamicResource FgBrush}" />
                                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,2">
                                        <views:SpinnerBox x:Name="AiTimeoutBox" Width="104" Min="5" Max="300" />
                                        <TextBlock Text="10 – 300 秒" VerticalAlignment="Center" Margin="8,0,0,0"
                                                   FontSize="11" Foreground="{DynamicResource SubFgBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button x:Name="AiFetchModelsButton" Content="获取模型" Width="90" Click="AiFetchModels_Click"
                                                ToolTip="用 Base URL + API Key 拉取可用模型列表" />
                                        <Button x:Name="AiTestButton" Content="测试连接" Width="90" Margin="8,0,0,0" Click="AiTest_Click" />
                                        <TextBlock x:Name="AiStatusText" VerticalAlignment="Center" Margin="10,0,0,0"
                                                   FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource SubFgBrush}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="AI 仅基于本地行情与历史数据进行分析，不构成投资建议。"
                                           FontSize="10" Margin="0,10,0,0" Foreground="{DynamicResource SubFgBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 6：通用 -->
            <TabItem Header="通用">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="系统" Style="{StaticResource CardHeaderText}" />
                                <CheckBox x:Name="AutoStartCheck" Content="开机自动启动" Margin="0,2" />
                                <CheckBox x:Name="GroupByCategoryCheck" Content="按市场分类自动分组" Margin="0,2" />
                                <CheckBox x:Name="ShowSparklineCheck" Content="显示迷你走势列（当日分时快照）" Margin="0,2" />
                                <TextBlock Text="分组颜色" Style="{StaticResource CardHeaderText}" Margin="0,12,0,5" />
                                <StackPanel x:Name="CategoryColorPanel" />
                                <Button Content="恢复默认分组颜色" Width="140" HorizontalAlignment="Left" Margin="0,8,0,0"
                                        Click="ResetCategoryColors_Click" />
                                <TextBlock Text="强调色" Style="{StaticResource CardHeaderText}" Margin="0,12,0,5" />
                                <WrapPanel x:Name="AccentPanel" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="数据" Style="{StaticResource CardHeaderText}" />
                                <TextBlock x:Name="DataDirText" Foreground="{DynamicResource SubFgBrush}" FontSize="11"
                                           TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="打开数据目录" Width="110" Click="OpenDataDir_Click" />
                                    <Button Content="从旧版导入数据…" Width="130" Margin="10,0,0,0" Click="ImportLegacy_Click" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="导出数据备份…" Width="110" Click="ExportBackup_Click" />
                                    <Button Content="导入数据备份…" Width="110" Margin="10,0,0,0" Click="ImportBackup_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="保存" Width="90" Style="{StaticResource PrimaryButtonStyle}" Click="Save_Click" />
            <Button Content="应用" Width="90" Margin="10,0,0,0" Click="Apply_Click" />
            <Button Content="取消" Width="90" Margin="10,0,0,0" Click="Cancel_Click" />
        </StackPanel>
    </Grid>
    </Border>
</views:GlassWindow>
