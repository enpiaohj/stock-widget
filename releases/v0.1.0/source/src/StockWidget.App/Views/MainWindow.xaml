<views:GlassWindow x:Class="StockWidget.App.Views.MainWindow"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:views="clr-namespace:StockWidget.App.Views"
                   Title="股票小插件"
                   Width="420" Height="360"
                   WindowStartupLocation="Manual"
                   ShowActivated="True"
                   Background="{DynamicResource BgBrush}"
                   TextOptions.TextRenderingMode="ClearType"
                   UseLayoutRounding="True">

    <Border CornerRadius="10" Background="Transparent">
        <Grid Margin="8,6,8,6" Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 顶部拖拽条（锁定时禁用） -->
            <Border x:Name="DragStrip" Grid.Row="0" Height="8" Background="Transparent"
                    MouseLeftButtonDown="DragStrip_MouseLeftButtonDown" />

            <!-- 行情表 -->
            <DataGrid x:Name="Grid" Grid.Row="1"
                      ItemsSource="{Binding Rows}"
                      SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                      Background="Transparent"
                      Foreground="{DynamicResource FgBrush}"
                      FontFamily="{Binding RowFontFamily, RelativeSource={RelativeSource AncestorType=Window}}"
                      FontSize="{Binding RowFontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                      FontStyle="{Binding RowFontStyle, RelativeSource={RelativeSource AncestorType=Window}}"
                      VirtualizingPanel.ScrollUnit="Pixel"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <DataGrid.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.ContainerStyle>
                            <Style TargetType="GroupItem" BasedOn="{StaticResource CategoryGroupHeaderStyle}" />
                        </GroupStyle.ContainerStyle>
                    </GroupStyle>
                </DataGrid.GroupStyle>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                        <Setter Property="Background" Value="{Binding FlashBrush}" />
                        <EventSetter Event="MouseLeftButtonUp" Handler="Row_MouseLeftButtonUp" />
                        <EventSetter Event="MouseDoubleClick" Handler="Row_MouseDoubleClick" />
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>

            <!-- 底部量能栏 -->
            <Grid Grid.Row="2" Margin="2,4,2,2" Background="Transparent"
                  MouseLeftButtonDown="DragStrip_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="AmountText" Grid.Column="0" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           MouseLeave="AmountText_MouseLeave"
                           MouseMove="AmountText_MouseMove" />
                <Border x:Name="MarketClosedBadge" Grid.Column="1" Visibility="Collapsed"
                        Background="{DynamicResource AccentSoftBrush}" CornerRadius="5"
                        Padding="8,2" VerticalAlignment="Center" Margin="8,0,0,0">
                    <TextBlock Text="休市" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}" />
                </Border>
            </Grid>
        </Grid>
    </Border>
</views:GlassWindow>
