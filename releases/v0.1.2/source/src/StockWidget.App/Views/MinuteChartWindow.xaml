<views:GlassWindow x:Class="StockWidget.App.Views.MinuteChartWindow"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:views="clr-namespace:StockWidget.App.Views"
                   Title="分时走势"
                   Width="520" Height="360"
                   WindowStartupLocation="CenterOwner"
                   ResizeMode="NoResize" ShowInTaskbar="False"
                   Background="{DynamicResource BgBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="NameText" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource FgBrush}" />
                <TextBlock x:Name="CodeText" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource SubFgBrush}" />
                <TextBlock x:Name="PriceText" FontSize="14" FontWeight="Bold" Margin="14,0,0,0"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="ChangeText" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" />
                <Border x:Name="ClosedBadge" Background="{DynamicResource AccentSoftBrush}" CornerRadius="5"
                        Padding="8,2" Margin="12,0,60,0" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="休市 / 无数据" FontSize="10" Foreground="{DynamicResource AccentBrush}" />
                </Border>
            </StackPanel>
            <!-- 关闭按钮：锚定右缘，加宽避免文字切边 -->
            <Button x:Name="CloseButton" Content="✕ 关闭" Width="80" HorizontalAlignment="Right"
                    Margin="0,0,-6,0" Click="Close_Click" VerticalAlignment="Center" />
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource CardBrush}" CornerRadius="10" Margin="0,12,0,0">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="HighText" FontSize="10" Foreground="{DynamicResource SubFgBrush}"
                           HorizontalAlignment="Right" />
                <views:Sparkline x:Name="Chart" Grid.Row="1" Margin="0,4" />
                <Rectangle x:Name="BaselineBar" Grid.Row="1" Height="1" Fill="{DynamicResource BaselineBrush}"
                           HorizontalAlignment="Stretch" VerticalAlignment="Center" Opacity="0.7"
                           Margin="0,4,0,4" Visibility="Collapsed" IsHitTestVisible="False" />
                <Grid Grid.Row="2">
                    <TextBlock x:Name="LowText" FontSize="10" Foreground="{DynamicResource SubFgBrush}" />
                    <TextBlock x:Name="TimeText" FontSize="10" Foreground="{DynamicResource SubFgBrush}"
                               HorizontalAlignment="Right" />
                </Grid>
            </Grid>
        </Border>

        <TextBlock Grid.Row="2" x:Name="PrevCloseText" FontSize="11" Foreground="{DynamicResource SubFgBrush}"
                   Margin="0,8,0,0" HorizontalAlignment="Right" />
    </Grid>
</views:GlassWindow>
